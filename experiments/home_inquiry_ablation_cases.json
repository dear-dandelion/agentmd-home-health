{
  "version": "2026-04-28",
  "description": "居家健康问询消融实验样本集：比较完整系统与去除医疗计算器库时的回答准确率。",
  "cases": [
    {
      "id": "bmi_obesity",
      "scenario_type": "calculator",
      "birth_date": "1980-01-01",
      "gender": "男",
      "seed_params": {
        "height_cm": 170,
        "weight_kg": 85
      },
      "message": "帮我评估BMI",
      "expected_tool": "bmi",
      "expected_risk_level": "肥胖",
      "expected_summary_contains": "BMI 为 29.4"
    },
    {
      "id": "blood_pressure_high",
      "scenario_type": "calculator",
      "birth_date": "1980-01-01",
      "gender": "男",
      "seed_params": {
        "systolic_bp": 148,
        "diastolic_bp": 96
      },
      "message": "帮我评估血压风险",
      "expected_tool": "blood_pressure",
      "expected_risk_level": "高风险",
      "expected_summary_contains": "血压为 148/96 mmHg"
    },
    {
      "id": "fasting_glucose_high",
      "scenario_type": "calculator",
      "birth_date": "1980-01-01",
      "gender": "女",
      "seed_params": {
        "fasting_glucose": 7.3
      },
      "message": "帮我评估空腹血糖",
      "expected_tool": "fasting_glucose",
      "expected_risk_level": "高风险",
      "expected_summary_contains": "空腹血糖为 7.3 mmol/L"
    },
    {
      "id": "waist_circumference_high",
      "scenario_type": "calculator",
      "birth_date": "1980-01-01",
      "gender": "男",
      "seed_params": {
        "waist_cm": 96
      },
      "message": "帮我评估腰围风险",
      "expected_tool": "waist_circumference",
      "expected_risk_level": "偏高",
      "expected_summary_contains": "腰围为 96.0 cm"
    },
    {
      "id": "resting_heart_rate_high",
      "scenario_type": "calculator",
      "birth_date": "1980-01-01",
      "gender": "男",
      "seed_params": {
        "heart_rate_bpm": 108
      },
      "message": "帮我评估静息心率",
      "expected_tool": "resting_heart_rate",
      "expected_risk_level": "偏高",
      "expected_summary_contains": "静息心率为 108 次/分"
    },
    {
      "id": "body_temperature_fever",
      "scenario_type": "calculator",
      "birth_date": "1980-01-01",
      "gender": "女",
      "seed_params": {
        "temperature_c": 38.6
      },
      "message": "帮我评估体温",
      "expected_tool": "body_temperature",
      "expected_risk_level": "高风险",
      "expected_summary_contains": "体温为 38.6 ℃"
    },
    {
      "id": "fall_risk_high",
      "scenario_type": "calculator",
      "birth_date": "1946-01-01",
      "gender": "男",
      "seed_params": {
        "balance_ability": "较差"
      },
      "message": "帮我评估跌倒风险",
      "expected_tool": "fall_risk",
      "expected_risk_level": "高风险",
      "expected_summary_contains": "跌倒风险评分为 4 分"
    },
    {
      "id": "phq9_moderately_severe",
      "scenario_type": "calculator",
      "birth_date": "1990-01-01",
      "gender": "女",
      "seed_params": {
        "total_score": 15
      },
      "message": "帮我评估PHQ-9抑郁情况",
      "expected_tool": "phq9",
      "expected_risk_level": "中重度抑郁风险",
      "expected_summary_contains": "PHQ-9 总分为 15 分"
    },
    {
      "id": "gad7_moderate",
      "scenario_type": "calculator",
      "birth_date": "1990-01-01",
      "gender": "女",
      "seed_params": {
        "total_score": 13
      },
      "message": "帮我评估GAD-7焦虑情况",
      "expected_tool": "gad7",
      "expected_risk_level": "中度焦虑风险",
