      "name": "age",
      "label": "年龄",
      "type": "float",
      "required": true,
      "description": "受评估者年龄",
      "min": 0,
      "max": 120
    },
    {
      "name": "bmi",
      "label": "BMI",
      "type": "float",
      "required": true,
      "description": "体重指数",
      "min": 10,
      "max": 80
    },
    {
      "name": "ast_u_l",
      "label": "AST",
      "type": "float",
      "required": true,
      "description": "谷草转氨酶",
      "min": 1,
      "max": 1000,
      "unit": "U/L"
    },
    {
      "name": "alt_u_l",
      "label": "ALT",
      "type": "float",
      "required": true,
      "description": "谷丙转氨酶",
      "min": 1,
      "max": 1000,
      "unit": "U/L"
    },
    {
      "name": "platelet_10e9_l",
      "label": "血小板",
      "type": "float",
      "required": true,
      "description": "血小板计数",
      "min": 1,
      "max": 1000,
      "unit": "10^9/L"
    },
    {
      "name": "albumin_g_dl",
      "label": "白蛋白",
      "type": "float",
      "required": true,
      "description": "白蛋白",
      "min": 0.1,
      "max": 10,
      "unit": "g/dL"
    },
    {
      "name": "impaired_fasting_glucose_or_diabetes",
      "label": "糖调节异常/糖尿病",
      "type": "bool",
      "required": true,
      "description": "是否存在糖调节异常或糖尿病"
    }
  ],
  "reference": "NAFLD fibrosis score 原始公式阈值。",
