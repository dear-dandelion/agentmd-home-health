    },
    {
      "name": "immobilization_or_recent_surgery",
      "label": "制动或近期手术",
      "type": "bool",
      "required": true,
      "description": "是否近期制动或手术"
    },
    {
      "name": "previous_dvt_pe",
      "label": "既往DVT/PE",
      "type": "bool",
      "required": true,
      "description": "是否存在既往 DVT 或 PE"
    },
    {
      "name": "hemoptysis",
      "label": "咯血",
      "type": "bool",
      "required": true,
      "description": "是否存在咯血"
    },
    {
      "name": "malignancy",
      "label": "恶性肿瘤",
      "type": "bool",
      "required": true,
      "description": "是否存在恶性肿瘤"
    }
  ],
